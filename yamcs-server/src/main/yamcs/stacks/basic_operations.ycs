{
  "advancement": {
    "acknowledgment": "Acknowledge_Sent",
    "wait": 500
  },
  "steps": [
    {
      "type": "command",
      "name": "/Rover/camera/camera_streaming",
      "arguments": [
        { "name": "camera_name", "value": "cam_color" },
        { "name": "action", "value": "START" }
      ],
      "comment": "Start streaming the color camera"
    },
    {
      "type": "verify",
      "comment": "Camera stream is ON (cam_color)",
      "condition": [
        { "parameter": "/Rover/camera/cam_color/streaming/state", "operator": "eq", "value": "ON" }
      ],
      "delay": 0,
      "timeout": 15000
    },
    {
      "type": "check",
      "comment": "Pose before driving",
      "parameters": [
        { "parameter": "/Rover/pose_ground_truth.position.x" },
        { "parameter": "/Rover/pose_ground_truth.position.y" },
        { "parameter": "/Rover/imu_orientation_deg.yaw" }
      ]
    },
    {
      "type": "command",
      "name": "/Rover/motor/drive_straight",
      "arguments": [
        { "name": "linear_velocity", "value": "0.2" },
        { "name": "distance", "value": "1.0" }
      ],
      "comment": "Drive straight 1 m at 0.2 m/s (about 5 s)",
      "advancement": { "acknowledgment": "Acknowledge_Sent", "wait": 7000 }
    },
    {
      "type": "check",
      "comment": "After driving: position moved by about 1 m",
      "parameters": [
        { "parameter": "/Rover/pose_ground_truth.position.x" },
        { "parameter": "/Rover/pose_ground_truth.position.y" },
        { "parameter": "/Rover/imu_orientation_deg.yaw" }
      ]
    },
    {
      "type": "command",
      "name": "/Rover/motor/drive_turn",
      "arguments": [
        { "name": "angular_velocity", "value": "10.0" },
        { "name": "angle", "value": "90.0" }
      ],
      "comment": "Turn 90 deg left at 10 deg/s (positive angular velocity = left, about 9 s)",
      "advancement": { "acknowledgment": "Acknowledge_Sent", "wait": 11000 }
    },
    {
      "type": "check",
      "comment": "After turning: yaw changed by about +90 deg",
      "parameters": [
        { "parameter": "/Rover/imu_orientation_deg.yaw" }
      ]
    }
  ]
}
